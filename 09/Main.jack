  function void printShapeInstructions(boolean isRectangle, boolean isCircle, boolean isTriangle) {
    do Main.clearBottomLine();
    if (isRectangle) { do Main.printRectangleInstructions(); }
    if (isCircle) { do Main.printCircleInstructions(); }
    if (isTriangle) { do Main.printTriangleInstructions(); }
    return;
  }

