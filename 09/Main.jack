  // Determines whether the shape is full or empty
  function boolean emptyOrFull() {

    var int key;
    var boolean loopEnd,full;
    var String str;

    do Main.printFullOrEmpty();
    
    let loopEnd = false;
    while (~loopEnd) {
      let key = Keyboard.keyPressed();
      if (key = FULL) {
        let full = true;
        let loopEnd = true;
      }
      if (key = EMPTY) {
        let full = false;
        let loopEnd = true;
      }
    }

  do Main.clearBottomLine();
    return full;
  }

  function void shapesMode(
          int vertices, boolean rectangle, boolean circle, boolean triangle, Pen p) {

    var int counter, key, temp;
    var Array xs, ys;
    var boolean full, selectedColor, esc;
    var Pen pen;

    do pen.startDrawing();
    let full = Main.emptyOrFull();
    let counter = 0;
    let xs = Array.new(vertices);
    let ys = Array.new(vertices);
    let selectedColor = p.getColor();
    do Main.printShapeInstructions(rectangle, circle, triangle);

    while (counter < vertices) {
      let key = Keyboard.keyPressed();

      if (key = UP)        { do pen.moveUp();    }
      if (key = DOWN)      { do pen.moveDown();  } 
      if (key = LEFT)      { do pen.moveLeft();  } 
      if (key = RIGHT)     { do pen.moveRight(); }  
      if (key = ENTER) {
        let temp = p.getX();
        let xs[counter] = temp;
        let temp = p.getY();
        let ys[counter] = temp;
        do Screen.setColor(selectedColor);
        do Screen.drawPixel(xs[counter], ys[counter]);
        let counter = counter + 1;
      }
      if (key = ESC) {
        let esc = true;
      }
    }

    do Main.clearBottomLine();

    if (rectangle & ~esc) {
      if (full) {
        do Shapes.draw_rectangle(xs[0], ys[0], xs[1], ys[1], selectedColor);
      }
      if (~full) {
        do Shapes.draw_rectangle_outline(xs[0], ys[0], xs[1], ys[1], selectedColor);
      }
    }

    if (circle & ~esc) {
      if (full) {
        do Shapes.draw_circle(xs[0], ys[0], xs[1], ys[1], selectedColor);
      }
      if (~full) {
        do Shapes.draw_circle_outline(xs[0], ys[0], xs[1], ys[1], selectedColor);
      }
    }

    if (triangle & ~esc) {
      if (full) {
        do Shapes.draw_triangle(xs[0], ys[0], xs[1], ys[1], xs[2], ys[2], selectedColor);
      }
      if (~full) {
        do Shapes.draw_triangle_outline(xs[0], ys[0], xs[1], ys[1], xs[2], ys[2], selectedColor);
      }
    }
    return;
  }

  function void main() {
    var Pen pen;
    var ToolsControl tb;
    var int key;
    var boolean exit;
    
    let UP        = 131; // up arrow
    let DOWN      = 133; // down arrow
    let LEFT      = 130; // left arrow
    let RIGHT     = 132; // right arrow
    let PEN       = 98;  // "b" (black)
    let ERASE     = 119; // "w" (wight)
    let RECTANGLE = 114; // "r" (rectangle)
    let CIRCLE    = 99;  // "c" (circle)
    let TRIANGLE  = 116; // "t" (triangle)
    let CLEAR     = 120; // "x"
    let ESC       = 27;  // "ESC"
    let FULL      = 102; // "f" (full)
    let EMPTY     = 101; // "e" (empty)
    let ENTER     = 13;  // "enter"
    let INCREASE  = 43;  // "+" 
    let DECREASE  = 45;  // "-"


    let pen = Pen.new(0, 0, 10);
    do Screen.clearScreen();
    do Main.printStartInstruction();
    do Screen.clearScreen();
    let tb = ToolsControl.new();
    do pen.drawPen();

    let key = 0;
    let exit = false;

    while (~exit) {

      do Main.printKeyInstructions();
      let key = Keyboard.keyPressed();

      if (key = UP)        { do pen.moveUp();    }
      if (key = DOWN)      { do pen.moveDown();  } 
      if (key = LEFT)      { do pen.moveLeft();  } 
      if (key = RIGHT)     { do pen.moveRight(); }  

      if (key = PEN) { 
          do tb.change_mode(0);
          do pen.startDrawing();
          do pen.setColor(true);
      } 

      if (key = ERASE) { 
          do tb.change_mode(1);
          do pen.startDrawing();
          do pen.setColor(false); 
      }

      if (key = RECTANGLE) { 
          do tb.change_mode(2); 
          do Main.shapesMode(2, true, false, false, pen);
      }

      if (key = CIRCLE) { 
          do tb.change_mode(3);
          do Main.shapesMode(2, false, true, false, pen);
      } 

      if (key = TRIANGLE) { 
          do tb.change_mode(4);
          do Main.shapesMode(3, false, false, true, pen);
      } 

      if (key = CLEAR) { 
          do tb.change_mode(5); 
          do Screen.setColor(false);
          do Screen.drawRectangle(0, 0, 511, 218);
      }

      if (key = INCREASE) {
          do pen.increaseSize();
      }

      if (key = DECREASE) {
          do pen.decreaseSize();
      }

      if (key = ESC) { let exit = true; }  

      do Sys.wait(50);
    }

    do pen.dispose();
    do tb.dispose();

    return;
  }
  
}
