/**
 * The Pen class is the main drawing tool of the application.
 * It represents a movable square-shaped "pen" on the screen,
 * capable of drawing, erasing, resizing, and changing color.
 * 
 * Responsibilities:
 * - Manages the pen's position (x, y) and width.
 * - Supports drawing mode (black) and erasing mode (white).
 * - Stores the background pixels under the pen to restore them when moved.
 * - Provides methods for movement, resizing, and drawing operations.
 * 
 * Usage:
 * A Pen object is created with an initial position and width,
 * then controlled through the methods defined below.
 *
 * Related classes:
 * - ToolsControl: manages the user’s shape/tool selection.
 * - Manager: coordinates the overall drawing application loop.
 */
class Pen {
    
    static int screenWidth, screenHeight;
    static int scaleFactor, minWidth, maxWidth, SCREEN, REGISTERLEN, REGISTERSLINE, BLACK, WHITE;
    field int x, y;                 // Current position of the pen (top-left corner)
    field int width;                // Width of the pen (square size)
    field boolean isDrawingMode;    // Whether the pen is in drawing mode (black) or erasing mode (white) 
    field boolean color;            // true = black, false = white
    field Array backgroundBuffer;   // Buffer to store screen content under the pen


    /**
     * Constructs a new Pen object at a given starting position and width.
     * Ensures the pen is created within safe screen boundaries.
     *
     * @param Ax The initial x-coordinate
     * @param Ay The initial y-coordinate
     * @param Awidth The initial width of the pen
     */
    constructor Pen new(int Ax, int Ay, int Awidth) { 
        
        var int safeWidth, safeX, safeY;

        let screenWidth = 511; // 0 to 511
        let screenHeight = 218; // 0 to 218
        let scaleFactor = 2;
        let minWidth = 1;
        let maxWidth = 30;
        let SCREEN = 16384;
        let REGISTERLEN = 16;
        let REGISTERSLINE = 32;
        let BLACK = 1;
        let WHITE = 0;

        let safeWidth = Math.min(Awidth, maxWidth);
        let width = safeWidth;

        let safeX = Math.max(0, Ax);
        let safeX = Math.min(safeX, (screenWidth - width));
        let x = safeX;

        let safeY = Math.max(0, Ay);
        let safeY = Math.min(safeY, (screenHeight - width));
        let y = safeY;

        let isDrawingMode = false;
        let color = true;

        // Allocate backgroundBuffer to save screen area under the pen.
        let backgroundBuffer = Array.new((maxWidth) * (maxWidth));
        return this;
    }

    /**
     * Gets the color of a specific pixel on the screen.
     *
     * @param x The x-coordinate of the pixel (0–511)
     * @param y The y-coordinate of the pixel (0–255)
     * @return true if the pixel is black, false if white
     */
    function boolean getPixel(int x, int y) {
        var int address, word, bitPosition, mask;
        
        let address = SCREEN + (y * REGISTERSLINE) + (x / REGISTERLEN);
        let word = Memory.peek(address);
        let bitPosition = 15 - (x & 15);
        let mask = (bitPosition * bitPosition);
        if (word & mask) {
            return true;
        }
        
        return false;
    }

    
    /**
     * Draws the pen's pointer shape on the screen.
     * The pointer is drawn as a black square with a white inner outline,
     * so the user can distinguish the pen position clearly.
     */
    method void drawPen() {

        var int i;
        var int row;
        var int rowEnd;
        var int col;
        var int colEnd;
        var boolean temp;
        
        if ( ( (x + width - 1) > screenWidth) | ( (y + width - 1) > screenHeight) ) {
            return;
        }


        let i = 0;
        let row = y;
        let rowEnd = y + width;
        while (row < rowEnd) {
            let col = x;
            let colEnd = x + width;
            while (col < colEnd) {
                let temp = Pen.getPixel(col, row);
                let backgroundBuffer[i] = temp;
                let i = i + 1;
                let col = col + 1;
            }
            let row = row + 1;
        }

        // draw square present the pointer
        do Screen.setColor(true); // black
        do Screen.drawRectangle(x, y, x + width - 1 , y + width - 1);

        // draw internal white square outline
        if (width > 2) {
            do Screen.setColor(false); // white
            do Screen.drawRectangle(x + 1, y + 1, x + width - 2, y + width - 2);
            if (width > 6) {
                do Screen.setColor(true);
                do Screen.drawRectangle(x + 3, y + 3, x + width - 4, y + width - 4);
            }
        }
        do Screen.setColor(true);
        return;

    }
    

    /**
     * Erases the pen's pointer shape by restoring the saved background.
     * Restores pixels from the buffer allocated when the pen was drawn.
     */
    method void erasePen() {

        var int i, row, rowEnd, col, colEnd;
        var boolean curColor;

        let i = 0;
        let row = y;
        let rowEnd = y + width;
        while (row < rowEnd) {
            let col = x;
            let colEnd = x + width;
            while (col < colEnd) {
                let curColor = false;
                if (backgroundBuffer[i]) {
                    let curColor = true;
                }
                do Screen.setColor(curColor);
                do Screen.drawPixel(col, row);
                let i = i + 1;
                let col = col + 1;
            }
            let row = row + 1;
        }
        return;
    }

    
    /**
     * Returns the current width of the pen.
     *
     * @return Current width of the pen (pixels)
     */
    method int getWidth() {
        return width;
    }


     /**
     * Checks if the pen is in drawing mode.
     *
     * @return true if the pen is drawing, false otherwise
     */
    method boolean isDrawing() {
        return isDrawingMode;
    }


    /**
     * Returns the current x-coordinate of the pen.
     *
     * @return The pen’s x position
     */
    method int getX() {
        return x;
    }


    /**
     * Returns the current y-coordinate of the pen.
     *
     * @return The pen’s y position
     */
    method int getY() {
        return y;
    }


    /**
     * Sets the pen to drawing mode (active painting).
     * While in this mode, movement leaves a trace on the screen.
     */
    method void startDrawing() {
        let isDrawingMode = true; 
        return;
    }


    /**
     * Sets the pen to "not drawing" mode.
     * While in this mode, the pen moves without leaving marks.
     */
    method void stopDrawing() {
        let isDrawingMode = false;
        return;
    }

    
    /**
     * Sets the pen’s color.
     *
     * @param inputColor true for black, false for white
     */
    method void setColor(boolean inputColor) {
        let color = inputColor;
        return;
    }

    /**
     * Gets the current pen color.
     *
     * @return true if black, false if white
     */
    method boolean getColor() {
        return color;
    }


    /**
     * Saves the pixels under the pen's square area
     * into the background buffer (does not draw).
     */
    method void draw() {

        var int i, row, rowEnd, col, colEnd;
        var boolean curColor;

        if (color) {
            let curColor = BLACK;
        }
        else {
            let curColor = WHITE;
        }
        
        let i = 0;
        let row = y;
        let rowEnd = y + width;
        while (row < rowEnd) {
            let col = x;
            let colEnd = x + width;
            while (col < colEnd) {
                let backgroundBuffer[i] = curColor;
                let i = i + 1;
                let col = col + 1;
            }
            let row = row + 1;
        }
        return;
    }


     /**
     * Increases the pen size by the fixed scale factor (e.g., +2 pixels).
     * The pen size will not grow beyond maxWidth or screen limits.
     */
    method void increaseSize() {
        
        if (((x + width + scaleFactor) > screenWidth) | 
            ((y + width + scaleFactor) > screenHeight) |
            ((width + scaleFactor) > maxWidth)) {
            return;
        }

        do erasePen();
        let width = width + scaleFactor;
        do drawPen();

        return;
    }


     /**
     * Decreases the pen size by the fixed scale factor (e.g., -2 pixels).
     * The pen size will not shrink below minWidth.
     */
    method void decreaseSize() {

        if ((width - scaleFactor) < minWidth) {
            return;
        }

        do erasePen();
        let width = width - scaleFactor;
        do drawPen();

        return;
    }


    /**
     * Moves the pen one pixel upward on the screen.
     * If in drawing mode, leaves a mark while moving.
     * Does nothing if already at the top boundary.
     */
    method void moveUp() {
        if ((y - 1) < 0) {
            return;
        }

        if (isDrawingMode) {
            do draw();
        }
        else {
            do erasePen();
        }
        
        let y = y - 1;
        do drawPen();
        return;
    }


    /**
     * Moves the pen one pixel downward on the screen.
     * If in drawing mode, leaves a mark while moving.
     * Does nothing if already at the bottom boundary.
     */
    method void moveDown() {
        if ((y + width + 1) > screenHeight) {
            return;
        }

        if (isDrawingMode) {
            do draw();
        }
        else {
            do erasePen();
        }
        let y = y + 1;
        do drawPen();
        return;
    }


    /**
     * Moves the pen one pixel to the right on the screen.
     * If in drawing mode, leaves a mark while moving.
     * Does nothing if already at the right boundary.
     */
    method void moveRight() {
        if ((x + width + 1) > screenWidth) {
            return;
        }

        if (isDrawingMode) {
            do draw();
        }
        else {
            do erasePen();
        }
        let x = x + 1;
        do drawPen();
        return;
    }


    /**
     * Moves the pen one pixel to the left on the screen.
     * If in drawing mode, leaves a mark while moving.
     * Does nothing if already at the left boundary.
     */
    method void moveLeft() {
        if ((x - 1) < 0) {
            return;
        }

        if (isDrawingMode) {
            do draw();
        }
        else {
            do erasePen();
        }
        let x = x - 1;
        do drawPen();
        return;
    }


    /**
     * Releases the resources used by this pen.
     * Deallocates the background buffer and the object itself.
     * Must be called explicitly to free memory.
     */
    method void dispose() {
        do Memory.deAlloc(backgroundBuffer);
        do Memory.deAlloc(this);
        return;
    }

}