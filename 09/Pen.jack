/** The Pen class represents the drawing tool in the drawing application. 
  This class encapsulates all logic related to the pen's state, including its position (x, y), 
  its width, and its mode (drawing or erasing). It is responsible for all actions 
  performed by the drawing tool, such as moving, changing size, and drawing or erasing on the screen.
 
  The class uses a set of fields to manage its state:
  - x, y: The current coordinates of the pen on the screen.
  - width: The current width of the pen's drawing stroke.
  - isDrawingMode: A boolean flag indicating whether the pen is in drawing mode.
 
  The class also uses static fields to define the screen boundaries and size limits, ensuring
  that all movements and size changes remain within the allowed range.
 */
class Pen {
    
    static int screenWidth, screenHeight, resizeIncrement;
    static int resizeDecrement, minWidth, maxWidth, SCREEN;
    field int x, y; // screen location of the pointer's top-left corner
    field int width; // line width in pixels
    field boolean isDrawingMode; // Indicates if the pen is in drawing (true) or erasing (false) mode 
    field boolean color;
    field Array backgroundBuffer;


    /** Constructs a new Pen object at a given starting position and width.
     
      @param Ax The initial x-coordinate.
      @param Ay The initial y-coordinate.
      @param Awidth The initial width of the pen.
     */
    constructor Pen new(int Ax, int Ay, int Awidth) { 
        
        var int safeWidth, safeX, safeY;

        let screenWidth = 511; // 0 to 511
        let screenHeight = 218; // 0 to 218
        let resizeIncrement = 2;
        let resizeDecrement = 2;
        let minWidth = 1;
        let maxWidth = 100;
        let SCREEN = 16384;

        let safeWidth = Math.min(Awidth, maxWidth);
        let width = safeWidth;

        let safeX = Math.max(0, Ax);
        let safeX = Math.min(safeX, (screenWidth - width));
        let x = safeX;

        let safeY = Math.max(0, Ay);
        let safeY = Math.min(safeY, (screenHeight - width));
        let y = safeY;

        let isDrawingMode = false;
        let color = true;

        // Allocate backgroundBuffer to save screen area under the pen.
        // Each word = 16 pixels; add 15 to ensure ceiling division.
        // backgroundBuffer size = ((maxWidth + 2)*(maxWidth + 2)+15)/16 words.
        let backgroundBuffer = Array.new(((maxWidth + 2) * (maxWidth + 2) + 15) / 16);
        return this;
    }

    
    /** Draws the pen's pointer shape on the screen in black. */
    method void drawPen() {

        var int i;
        var int row;
        var int rowEnd;
        var int col;
        var int colEnd;
        var int address;
        var int temp;
        
        if ( ( (x + width + 1) > screenWidth) | ( (y + width + 1) > screenHeight) ) {
            return;
        }

        // Save the background to the backgroundBuffer 
        let i = 0;
        let row = y;
        let rowEnd = (y + width);
        while (row < rowEnd + 1) {
            let col = x / 16;  
            let colEnd = (x + width) / 16;
            while (col < colEnd + 1) {
                let address = SCREEN + (row * 32) + col;
                let temp = Memory.peek(address);
                let backgroundBuffer[i] = temp;
                let i = i + 1;
                let col = col + 1;
            }
            let row = row + 1;
        }

        // draw square present the pointer
        do Screen.setColor(true); // black
        do Screen.drawRectangle(x, y, x + width + 1, y + width + 1);

        // draw internal white square outline
        do Screen.setColor(false); // white
        do Screen.drawRectangle(x + 1, y + 1, x + width, y + width);
        if (width > 4) {
            do Screen.setColor(true);
            do Screen.drawRectangle(x + 4, y + 4, x + width - 3, y + width - 3);
        }
        
        do Screen.setColor(true);
        return;
    }
    

    /** Erases the pen's pointer shape from the screen by drawing the previous background. */
    method void erasePen() {

        var int i, row, rowEnd, col, colEnd, address, value;

        let i = 0;
        let row = y;
        let rowEnd = (y + width); 
        while (row < rowEnd + 1) {
            let col = x / 16;  
            let colEnd = (x + width) / 16;

            while (col < colEnd + 1) {
                let address = SCREEN + (row * 32) + col;
                let value = backgroundBuffer[i];
                do Memory.poke(address, value);
                let i = i + 1;
                let col = col + 1;
            }
            let row = row + 1;
        }
        
        return;
    }

    
    /** Returns the current width of the pen. */
    method int getWidth() {
        return width;
    }


    /**  
      Checks if the pen is in drawing mode.
     
      @return true if the pen is in drawing mode, false otherwise.
     */
    method boolean isDrawing() {
        return isDrawingMode;
    }


    /** 
      Returns the current x-coordinate of the pen on the screen.
    
      @return The x-coordinate of the pen.
    */
    method int getX() {
        return x;
    }


    /**
     Returns the current y-coordinate of the pen on the screen.
    
     @return The y-coordinate of the pen.
    */
    method int getY() {
        return y;
    }


    /** Sets the pen to drawing mode (black). */
    method void startDrawing() {
        let isDrawingMode = true;
        return;
    }


    /** Sets the pen to no drawing mode (white). */
    method void stopDrawing() {
        let isDrawingMode = false;
        return;
    }


    /**
      Draws a line or square at the current pen location based on the drawing mode.
      The actual shape drawn depends on the pen's width.
     */
    method void draw() {

        var int i, row, rowEnd, col, colEnd, value;
        var boolean temp;

        if (~isDrawingMode) {
            return;
        } 

        let i = 0;
        let row = y;
        let rowEnd = (y + width);
        while (row < rowEnd + 1) {
            let col = x / 16;  
            let colEnd = (x + width) / 16;
            while (col < colEnd + 1) {
                let temp = color;
                let backgroundBuffer[i] = temp;
                let i = i + 1;
                let col = col + 1;
            }
            let row = row + 1;
        }
        return;
    }


    /** Increments the pen width by a fixed value (2 pixels), up to a maximum size. */
    method void increaseSize() {
        
        if (((x + width + 2) > screenWidth) | 
            ((y + width + 2) > screenHeight) |
            ((width + 2) > maxWidth)) {
            return;
        }

        do erasePen();
        let width = width + 2;
        do drawPen();

        return;
    }


    /** Decrements the pen width by a fixed value (2 pixels), down to a minimum size. */
    method void decreaseSize() {

        if ((width - 2) < minWidth) {
            return;
        }

        do erasePen();
        let width = width - 2;
        do drawPen();

        return;
    }


    /** Moves the pen one pixel up. */
    method void moveUp() {
        if ((y - 1) < 0) {
            return;
        }

        do erasePen();
        let y = y - 1;
        do drawPen();
        return;
    }


    /** Moves the pen one pixel down. */
    method void moveDown() {
        if ((y + width + 1) > screenHeight) {
            return;
        }

        do erasePen();
        let y = y + 1;
        do drawPen();
        return;
    }


    /** Moves the pen one pixel to the right. */
    method void moveRight() {
        if ((x + width + 1) > screenWidth) {
            return;
        }

        do erasePen();
        let x = x + 1;
        do drawPen();
        return;
    }


    /** Moves the pen one pixel to the left. */
    method void moveLeft() {
        if ((x - 1) < 0) {
            return;
        }

        do erasePen();
        let x = x - 1;
        do drawPen();
        return;
    }


    /**
      Disposes this Pen object and its resources.
      This method must be called explicitly when the Pen is no longer needed.
     */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

}