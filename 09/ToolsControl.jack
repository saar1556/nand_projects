    method void drawChars() {
        var int i,row,col;
        var Array chars;
        let i = 0;
        
        // setting the last row as default
        let row = 22;

        let chars = Array.new(NUM_BTNS);
        let chars[MODE_PEN] = PEN_CHAR;
        let chars[MODE_ERASE] = ERASE_CHAR;
        let chars[MODE_RECT] = REC_CHAR;
        let chars[MODE_CIRCLE] = CIR_CHAR;
        let chars[MODE_TRI] = TRI_CHAR;
        let chars[MODE_CLEAR] = CLEAR_CHAR;
        let chars[ADJ_SIZE] = RESIZE_CHAR;

        // printing each character at the buttom of the screen
        while (i < NUM_BTNS) {
                let col = (btn_locs[i] + (BTN_WID/2))/8;
                do Output.moveCursor(row,col);
                do Output.printString(chars[i]);
                let i = i + 1;
        }

        do chars.dispose();
        return;
    }


// ############################################################################################

    /**
     * Selects and highlights a new drawing mode. This method should erase
     * the highlight from the previous mode and draw a new highlight around
     * the selected mode's icon.
     *
     * @param newMode The integer representing the new mode to select.
     */
    method void change_mode(int newMode) {
        var int mode;
        let mode = -1;

        // checking if a new valid mode is inputted
        if (newMode = PEN)       {let mode = MODE_PEN;}
        if (newMode = ERASE)     {let mode = MODE_ERASE;}
        if (newMode = RECTANGLE) {let mode = MODE_RECT;}
        if (newMode = CIRCLE)    {let mode = MODE_CIRCLE;}
        if (newMode = TRIANGLE)  {let mode = MODE_TRI;}
        if (newMode = CLEAR)     {let mode = MODE_CLEAR;}
        if (mode = -1 | mode = currentMode) {return;}

        // drawing a square around the picked mode and updating instrucion
        do drawBorder(currentMode,false);
        let currentMode = mode;
        do drawBorder(currentMode,true);
        do printInstruciton();
        
        return;
    }

    /**
     * Saves the portion of the drawing canvas that will be overwritten by instructions
     * into a temporary memory buffer.
     */
    method void printInstruciton() {
        var int pad,row,col;
        let pad = 5;

        // calculate text location using (x,y) = x/8 + y/11
        let row = (TOOL_Y1/11);
        let col = (TOOL_X2 + pad)/8;

        do Screen.setColor(false);
        do Screen.drawRectangle(TOOL_X2+1,TOOL_Y1+1,511,255);
        do Screen.setColor(true);

        // generating message
        do Output.moveCursor(row,col);
        if (currentMode = MODE_PEN) { 
            do Output.printString("Pen: use keyboard arrows to move");
        }

        if (currentMode = MODE_ERASE) {
            do Output.printString("Eraser: use keyboard arrows to move");
        }

        if (currentMode = MODE_RECT) {
            do Output.printString("Rectagnle: PICK f=fill,e=empty THEN");
            do Output.moveCursor(row+1,col);
            do Output.printString("Mark diagonal edges.");
            do Output.moveCursor(row+2,col);
            do Output.printString("Enter=mark,q=cancel");
        }

        if (currentMode = MODE_CIRCLE) {
            do Output.printString("Circle: PICK f=fill,e=empty THEN");
            do Output.moveCursor(row+1,col);
            do Output.printString("Mark center then edge.");
            do Output.moveCursor(row+2,col);
            do Output.printString("Enter=mark,q=cancel");
        }

        if (currentMode = MODE_TRI) {
            do Output.printString("Triangle: PICK f=fill,e=empty THEN");
            do Output.moveCursor(row+1,col);
            do Output.printString("Mark 3 vertices.");
            do Output.moveCursor(row+2,col);
            do Output.printString("Enter=mark,q=cancel");
        }

        if (currentMode = MODE_CLEAR) {
            do Output.printString("board has been cleared.");
        }
        return;
    }

// ############################################################################################

    /**
     * Disposes this ToolsControl object and its resources.
     * This method must be called explicitly when the object is no longer needed.
     */
    method void dispose() {
        // 3) finally, free this object (optional; only if you won’t use it again)
        do Memory.deAlloc(this);
        return;
    }
}
