/**
 *  methods list:
 *
 *  constructor()
 *  draw()
 *  change_mode()
 *  showInstructions()
 *  hideInstructions()
 *  updateSize()
 *
 *  Array moods : [pen, eraser, square, circle, triangle]
 */

/**
 * The ToolsControl class is responsible for managing the graphical user interface (GUI) of the drawing application,
 * specifically the toolbar and the instructions displayed to the user. This class handles the selection of different
 * drawing modes (like pen, eraser, etc.) and is also responsible for the temporary display of instructions,
 * including saving and restoring the canvas's state from memory.
 *
 * The toolbar is drawn at the bottom of the screen, occupying the area from y-coordinate 220 to 255.
 * The drawing canvas area for the user is therefore limited to the space above the toolbar.
 *
 * @field currentMode: Holds an integer representing the currently selected drawing mode.
 * @field modes: A static array that holds the available drawing modes.
 * @field screenBuffer: A temporary memory buffer used to store a portion of the screen
 * when instructions are displayed, to allow for later restoration.
 */

class ToolsControl {

    /** Modes */
    static int MODE_PEN, MODE_ERASE, MODE_LINE, MODE_RECT, MODE_CIRCLE, MODE_TRI, MODE_CLEAR;

    /** Layout */
    static int TOOL_Y1, TOOL_Y2, BTN_TOP, BTN_BOT, BTN_PAD, NUM_BTNS;

    /** State */
    field int currentMode;

    /** Constructor */
    constructor ToolsControl new() {
        let MODE_PEN    = 0;
        let MODE_ERASE  = 1;
        let MODE_LINE   = 2;
        let MODE_RECT   = 3;
        let MODE_CIRCLE = 4;
        let MODE_TRI    = 5;
        let MODE_CLEAR  = 6;

        let TOOL_Y1 = 220;
        let TOOL_Y2 = 255;
        let BTN_TOP = 224;
        let BTN_BOT = 252;
        let BTN_PAD = 2;
        let NUM_BTNS = 7;

        let currentMode = MODE_PEN;

        do draw();
        return this;
    }

    /**
     * Draws the entire toolbar interface, including mode icons and labels.
     * This method should be called once after the object is constructed.
     */
    method void draw() {
        var int i, cellW, x1, x2;

        // clear toolbar strip (white) and draw a top border line
        do Screen.setColor(false);                          // white
        do Screen.drawRectangle(0, TOOL_Y1, 511, TOOL_Y2);
        do Screen.setColor(true);                           // black
        do Screen.drawLine(0, TOOL_Y1 - 1, 511, TOOL_Y1 - 1);

        // cell width (integer division)
        let cellW = 512 / NUM_BTNS;

        // draw each button
        let i = 0;
        while (i < NUM_BTNS) {
            let x1 = i * cellW + BTN_PAD;
            let x2 = (i + 1) * cellW - BTN_PAD - 1;
            do drawButton(i, x1, BTN_TOP, x2, BTN_BOT, (i = currentMode));
            let i = i + 1;
        }

        // leave color black as default
        do Screen.setColor(true);
        return;
    }

    /**
     * Saves the portion of the drawing canvas that will be overwritten by instructions
     * into a temporary memory buffer.
     */
    method void showInstructions() {
        let screenBuffer = Memory.alloc(ToolsControl.instructionsBufferSize);
        // ... copy screen content
        // ... display instructions
        return;
    }

    //* Restores the drawing canvas from the temporary buffer. */
    method void hideInstructions() {
        // ... copy buffer content to screen
        do Memory.deAlloc(screenBuffer);
        return;
    }


    /**
     * Selects and highlights a new drawing mode. This method should erase
     * the highlight from the previous mode and draw a new highlight around
     * the selected mode's icon.
     *
     * @param newMode The integer representing the new mode to select.
     */
    method void change_mode(int newMode) {
        if (newMode < 7 & mode > -1) { let currentMode = newMode; }
        return;
    }

    /**
     * Updates the size display on the toolbar.
     *
     * @param newSize The new integer value to display for the pen/shape size.
     */
    method void updateSize(int newSize) {
        return;
    }

    /**
     * Disposes this ToolsControl object and its resources.
     * This method must be called explicitly when the object is no longer needed.
     */
    method void dispose() {
        return;
    }

}
