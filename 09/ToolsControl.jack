    method void drawPenSize(int newSize) {
        var int d1, d2, loc1, loc2;

        // clamp to 0..99 (optional safety)
        if (newSize < 0)  { let newSize = 0;  }
        if (newSize > 99) { let newSize = 99; }

        let d1 = newSize / 10;              // tens
        let d2 = newSize - (d1 * 10);       // ones

        // word offsets: row = BTN_TOP, col = x/16
        let loc1 = 32 * BTN_TOP + (btn_locs[ADJ_SIZE] / 16);

        // NOTE: parenthesis so the whole (x + width + pad) is divided by 16
        let loc2 = 32 * BTN_TOP + ((btn_locs[ADJ_SIZE] + BTN_WID) / 16);

        // ---- tens digit ----
        if (d1 = 0) { do draw0(loc1); }
        if (d1 = 1) { do draw1(loc1); }
        if (d1 = 2) { do draw2(loc1); }
        if (d1 = 3) { do draw3(loc1); }
        if (d1 = 4) { do draw4(loc1); }
        if (d1 = 5) { do draw5(loc1); }
        if (d1 = 6) { do draw6(loc1); }
        if (d1 = 7) { do draw7(loc1); }
        if (d1 = 8) { do draw8(loc1); }
        if (d1 = 9) { do draw9(loc1); }

        // ---- ones digit ----
        if (d2 = 0) { do draw0(loc2); }
        if (d2 = 1) { do draw1(loc2); }
        if (d2 = 2) { do draw2(loc2); }
        if (d2 = 3) { do draw3(loc2); }
        if (d2 = 4) { do draw4(loc2); }
        if (d2 = 5) { do draw5(loc2); }
        if (d2 = 6) { do draw6(loc2); }
        if (d2 = 7) { do draw7(loc2); }
        if (d2 = 8) { do draw8(loc2); }
        if (d2 = 9) { do draw9(loc2); }

        return;
    }

