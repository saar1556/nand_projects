/**
 *  methods list:
 *
 *  constructor()
 *  draw()
 *  change_mode()
 *  showInstructions()
 *  hideInstructions()
 *  updateSize()
 *
 *  Array moods : [pen, eraser, square, circle, triangle]
 */

/**
 * The ToolsControl class is responsible for managing the graphical user interface (GUI) of the drawing application,
 * specifically the toolbar and the instructions displayed to the user. This class handles the selection of different
 * drawing modes (like pen, eraser, etc.) and is also responsible for the temporary display of instructions,
 * including saving and restoring the canvas's state from memory.
 *
 * The toolbar is drawn at the bottom of the screen, occupying the area from y-coordinate 220 to 255.
 * The drawing canvas area for the user is therefore limited to the space above the toolbar.
 *
 * @field currentMode: Holds an integer representing the currently selected drawing mode.
 * @field modes: A static array that holds the available drawing modes.
 * @field screenBuffer: A temporary memory buffer used to store a portion of the screen
 * when instructions are displayed, to allow for later restoration.
 */

class ToolsControl {

    /** Modes */
    static int MODE_PEN, MODE_ERASE, MODE_RECT, MODE_CIRCLE, MODE_TRI, MODE_CLEAR, ADJ_SIZE;

    /** Layout */
    static int TOOL_Y1,TOOL_X1, TOOL_X2, TOOL_Y2, VERT_EDG ,HOR_EDG, BTN_TOP, BTN_BOT, BTN_WID, BTN_PAD;

    /** Const Params */
    static int NUM_BTNS;
    static int PEN,ERASE,RECTANGLE,CIRCLE,TRIANGLE,CLEAR;
    static String PEN_CHAR,ERASE_CHAR,REC_CHAR,CIR_CHAR,TRI_CHAR,CLEAR_CHAR,RESIZE_CHAR;

    /** dynamic params */
    field int currentMode,pen_size;
    field Array btn_locs;

    /** Constructor */
    constructor ToolsControl new() {

        // keys
        let PEN       = 66;  // "B" (black)
        let ERASE     = 87;  // "W" (white)
        let RECTANGLE = 82;  // "R" (rectangle)
        let CIRCLE    = 67;  // "C" (circle)
        let TRIANGLE  = 84;  // "T" (triangle)
        let CLEAR     = 88;  // "X"

        let PEN_CHAR = "b";
        let ERASE_CHAR = "w";
        let REC_CHAR = "r";
        let CIR_CHAR = "c";
        let TRI_CHAR = "t";
        let CLEAR_CHAR = "x";
        let RESIZE_CHAR = "+/-";

        // each mode index
        let MODE_PEN    = 0;
        let MODE_ERASE  = 1;
        let MODE_RECT   = 2;
        let MODE_CIRCLE = 3;
        let MODE_TRI    = 4;
        let MODE_CLEAR  = 5;
        let ADJ_SIZE    = 6;

        // layout
        let TOOL_Y1  = 220;
        let TOOL_Y2  = 242;
        let TOOL_X1  = 0;
        let TOOL_X2  = 227;
        let VERT_EDG = 255;
        let HOR_EDG = 511;
        let BTN_TOP = 224;
        let BTN_BOT = 240;
        let BTN_WID = 16;
        let BTN_PAD = 2;
        let NUM_BTNS = 7;

        // general purpose variables
        let pen_size = 5;
        let currentMode = MODE_PEN;
        let btn_locs = Array.new(NUM_BTNS);

        // fill btn_locs 
        do calculateLocations();

        do draw();
        return this;
    }

    method void calculateLocations() {
        var int i;
        let i = 0;
        while (i < NUM_BTNS) {
            let btn_locs[i] = BTN_PAD * i * (BTN_WID);   // desired left edge
            let i = i + 1;
        }
        return;
    }
// ############################################################################################
// draw ToolBox
// ############################################################################################

    /**
     * Draws the entire toolbar interface, including mode icons and labels.
     * This method should be called once after the object is constructed.
     */
    method void draw() {
        var int mode,loc,r,i;

        // clear toolbar strip (white) and draw a top border line
        do Screen.setColor(false);                          // white
        do Screen.drawRectangle(0, TOOL_Y1, HOR_EDG, VERT_EDG);
        do Screen.setColor(true);                           // black

        // drawing tool box boundries
        do Screen.drawLine(TOOL_X1, TOOL_Y1, HOR_EDG, TOOL_Y1);
        do Screen.drawLine(TOOL_X1, TOOL_Y2,TOOL_X2 ,TOOL_Y2);
        let i = 0;
        while (i < (NUM_BTNS-1)) {
            let loc = btn_locs[i] + ((3*BTN_WID)/2);
            do Screen.drawLine(loc, TOOL_Y1,loc ,TOOL_Y2);
            let i = i + 1;
        }
        do Screen.drawLine(TOOL_X2, TOOL_Y1,TOOL_X2 ,TOOL_Y2);
        
        // drawing icons by calculating location using (x,y) = 32*y + [x/16]
        do drawPen((32*BTN_TOP) + (btn_locs[MODE_PEN]/16)); // mode pen
        do drawEraser((32*BTN_TOP) + (btn_locs[MODE_ERASE]/16)); // mode eraser
        do drawRectangle((32*BTN_TOP) + (btn_locs[MODE_RECT]/16)); // mode rectangle
        do drawCircle((32*BTN_TOP) + (btn_locs[MODE_CIRCLE]/16)); // mode circle
        do drawTriangle((32*BTN_TOP) + (btn_locs[MODE_TRI]/16)); // more triangle
        do drawClear((32*BTN_TOP) + (btn_locs[MODE_CLEAR]/16)); // clear
        do drawPenSize(pen_size);
        
        // initialize pen UI by default
        do drawBorder(MODE_PEN,true);
        do printInstruciton();
        do drawChars();

        // leave color black as default
        do Screen.setColor(true);

        return;
    }

    method void drawBorder(int mode, boolean selected) {
        var int x1, x2;
        var int y1, y2;

        let x1 = btn_locs[mode];
        let x2 = btn_locs[mode] + BTN_WID;

        // adjusting unique looking icons
        if (~(mode = MODE_PEN)) {let x1 = x1 - 1; let x2 = x2-1;}
        if (mode = MODE_CIRCLE) {let x2 = x2 + 1;}

        let y1 = BTN_TOP;
        let y2 = BTN_BOT;
        
        // border color
        if (selected) { do Screen.setColor(true); } 
        else { do Screen.setColor(false); } 

        // border only
        do Screen.drawLine(x1, y1, x2, y1);
        do Screen.drawLine(x2, y1, x2, y2);
        do Screen.drawLine(x2, y2, x1, y2);
        do Screen.drawLine(x1, y2, x1, y1);

        return;
    }

    method void drawPen(int location) {
        var int memAddress;
        let memAddress = 16384+location;
        do Memory.poke(memAddress+0, 0);
        do Memory.poke(memAddress+32, 384);
        do Memory.poke(memAddress+64, 576);
        do Memory.poke(memAddress+96, 1056);
        do Memory.poke(memAddress+128, 2016);
        do Memory.poke(memAddress+160, 1056);
        do Memory.poke(memAddress+192, 1056);
        do Memory.poke(memAddress+224, 1056);
        do Memory.poke(memAddress+256, 1056);
        do Memory.poke(memAddress+288, 1056);
        do Memory.poke(memAddress+320, 1056);
        do Memory.poke(memAddress+352, 2016);
        do Memory.poke(memAddress+384, 1056);
        do Memory.poke(memAddress+416, 1056);
        do Memory.poke(memAddress+448, 2016);
        do Memory.poke(memAddress+480, 0);
        return;
    }

