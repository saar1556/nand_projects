/**
 *  methods list:
 *
 *  constructor()
 *  draw()
 *  change_mode()
 *  showInstructions()
 *  hideInstructions()
 *  updateSize()
 *
 *  Array moods : [pen, eraser, square, circle, triangle]
 */

/**
 * The ToolsControl class is responsible for managing the graphical user interface (GUI) of the drawing application,
 * specifically the toolbar and the instructions displayed to the user. This class handles the selection of different
 * drawing modes (like pen, eraser, etc.) and is also responsible for the temporary display of instructions,
 * including saving and restoring the canvas's state from memory.
 *
 * The toolbar is drawn at the bottom of the screen, occupying the area from y-coordinate 220 to 255.
 * The drawing canvas area for the user is therefore limited to the space above the toolbar.
 *
 * @field currentMode: Holds an integer representing the currently selected drawing mode.
 * @field modes: A static array that holds the available drawing modes.
 * @field screenBuffer: A temporary memory buffer used to store a portion of the screen
 * when instructions are displayed, to allow for later restoration.
 */

class ToolsControl {

    /** Modes */
    static int MODE_PEN, MODE_ERASE, MODE_RECT, MODE_CIRCLE, MODE_TRI, MODE_CLEAR;

    /** Layout */
    static int TOOL_Y1, TOOL_Y2, BTN_TOP, BTN_BOT, BTN_WID, BTN_PAD, NUM_BTNS;

    /** State */
    field int currentMode;
    field Array screenBuffer;     // null when not used
    field boolean hasBuf;

    field Array btn_locs;

    /** Constructor */
    constructor ToolsControl new() {

        let MODE_PEN    = 0;
        let MODE_ERASE  = 1;
        let MODE_RECT   = 2;
        let MODE_CIRCLE = 3;
        let MODE_TRI    = 4;
        let MODE_CLEAR  = 5;

        let TOOL_Y1 = 219;
        let TOOL_Y2 = 255;
        let BTN_TOP = 224;
        let BTN_BOT = 240;
        let BTN_WID = 16;
        let BTN_PAD = 2;
        let NUM_BTNS = 6;


        let currentMode = MODE_PEN;
        let screenBuffer = null;
        let hasBuf = false;

        let btn_locs = Array.new(NUM_BTNS);
        do calculateLocations();

        do draw();
        return this;
    }


    method void calculateLocations() {
        var int i;
        let i = 0;
        while (i < NUM_BTNS) {
            let btn_locs[i] = BTN_PAD * i * (BTN_WID);   // desired left edge
            let i = i + 1;
        }
        return;
    }
// ############################################################################################
// draw ToolBox
// ############################################################################################

        /**
     * Draws the entire toolbar interface, including mode icons and labels.
     * This method should be called once after the object is constructed.
     */
    method void draw() {
        var int mode,loc,r;

        // clear toolbar strip (white) and draw a top border line
        do Screen.setColor(false);                          // white
        do Screen.drawRectangle(0, TOOL_Y1, 511, TOOL_Y2);
        do Screen.setColor(true);                           // black
        do Screen.drawLine(0, TOOL_Y1 - 1, 511, TOOL_Y1 - 1);

        do drawPen((32*BTN_TOP) + (btn_locs[0]/16)); // mode pen
        do drawEraser((32*BTN_TOP) + (btn_locs[1]/16)); // mode eraser
        do drawRectangle((32*BTN_TOP) + (btn_locs[2]/16)); // mode rectangle
        do drawCircle((32*BTN_TOP) + (btn_locs[3]/16)); // mode circle
        do drawTriangle((32*BTN_TOP) + (btn_locs[4]/16)); // more triangle
        do drawClear((32*BTN_TOP) + (btn_locs[5]/16)); // clear

        do drawBorder(0,true);

        // leave color black as default
        do Screen.setColor(true);

       return;
    }

    method void drawBorder(int mode, boolean selected) {
        var int x1, x2;
        var int y1, y2;

        let x1 = btn_locs[mode];
        let x2 = btn_locs[mode] + BTN_WID;

        if (~(mode = 0)) {let x1 = x1 - 1; let x2 = x2-1;}
        if (mode = 3) {let x2 = x2 + 1;}

        let y1 = BTN_TOP;
        let y2 = BTN_BOT;

        
        // background
        if (selected) {
            do Screen.setColor(true);                 
        } 
        else
        {
            do Screen.setColor(false);
        } 

        // border only
        do Screen.drawLine(x1, y1, x2, y1);
        do Screen.drawLine(x2, y1, x2, y2);
        do Screen.drawLine(x2, y2, x1, y2);
        do Screen.drawLine(x1, y2, x1, y1);

        return;
    }

    method void drawPen(int location) {
        var int memAddress;
        let memAddress = 16384+location;
        do Memory.poke(memAddress+0, 0);
        do Memory.poke(memAddress+32, 384);
        do Memory.poke(memAddress+64, 576);
        do Memory.poke(memAddress+96, 1056);
        do Memory.poke(memAddress+128, 2016);
        do Memory.poke(memAddress+160, 1056);
        do Memory.poke(memAddress+192, 1056);
        do Memory.poke(memAddress+224, 1056);
        do Memory.poke(memAddress+256, 1056);
        do Memory.poke(memAddress+288, 1056);
        do Memory.poke(memAddress+320, 1056);
        do Memory.poke(memAddress+352, 2016);
        do Memory.poke(memAddress+384, 1056);
        do Memory.poke(memAddress+416, 1056);
        do Memory.poke(memAddress+448, 2016);
        do Memory.poke(memAddress+480, 0);
        return;
    }

    method void drawEraser(int location) {
        var int memAddress;
        let memAddress = 16384+location;
        do Memory.poke(memAddress+0, 0);
        do Memory.poke(memAddress+32, 96);
        do Memory.poke(memAddress+64, 144);
        do Memory.poke(memAddress+96, 456);
        do Memory.poke(memAddress+128, 996);
        do Memory.poke(memAddress+160, 2034);
        do Memory.poke(memAddress+192, 4090);
        do Memory.poke(memAddress+224, 6140);
        do Memory.poke(memAddress+256, 9208);
        do Memory.poke(memAddress+288, 8688);
        do Memory.poke(memAddress+320, 8416);
        do Memory.poke(memAddress+352, 4160);
        do Memory.poke(memAddress+384, 2176);
        do Memory.poke(memAddress+416, 1792);
        do Memory.poke(memAddress+448, 0);
        do Memory.poke(memAddress+480, 0);
        return;
    }

    method void drawRectangle(int location) {
        var int memAddress;

        let memAddress = 16384+location;
        do Memory.poke(memAddress+0, 0);
        do Memory.poke(memAddress+32, 0);
        do Memory.poke(memAddress+64, 0);
        do Memory.poke(memAddress+96, 16382);
        do Memory.poke(memAddress+128, 8194);
        do Memory.poke(memAddress+160, 8194);
        do Memory.poke(memAddress+192, 8194);
        do Memory.poke(memAddress+224, 8194);
        do Memory.poke(memAddress+256, 8194);
        do Memory.poke(memAddress+288, 8194);
        do Memory.poke(memAddress+320, 8194);
        do Memory.poke(memAddress+352, 16382);
        do Memory.poke(memAddress+384, 0);
        do Memory.poke(memAddress+416, 0);
        do Memory.poke(memAddress+448, 0);
        do Memory.poke(memAddress+480, 0);
        return;
    }

    method void drawCircle(int location) {
        var int memAddress;

        let memAddress = 16384+location;
        do Memory.poke(memAddress+0, 0);
        do Memory.poke(memAddress+32, 2016);
        do Memory.poke(memAddress+64, 6168);
        do Memory.poke(memAddress+96, 8196);
        do Memory.poke(memAddress+128, 16386);
        do Memory.poke(memAddress+160, 16386);
        do Memory.poke(memAddress+192, -32767);
        do Memory.poke(memAddress+224, -32767);
        do Memory.poke(memAddress+256, -32767);
        do Memory.poke(memAddress+288, -32767);
        do Memory.poke(memAddress+320, -32767);
        do Memory.poke(memAddress+352, 16386);
        do Memory.poke(memAddress+384, 16386);
        do Memory.poke(memAddress+416, 8196);
        do Memory.poke(memAddress+448, 6168);
        do Memory.poke(memAddress+480, 2016);
        return;
    }

    method void drawTriangle(int location) {
        var int memAddress;
        let memAddress = 16384+location;
        do Memory.poke(memAddress+0, 0);
        do Memory.poke(memAddress+32, 128);
        do Memory.poke(memAddress+64, 320);
        do Memory.poke(memAddress+96, 320);
        do Memory.poke(memAddress+128, 544);
        do Memory.poke(memAddress+160, 544);
        do Memory.poke(memAddress+192, 1040);
        do Memory.poke(memAddress+224, 1040);
        do Memory.poke(memAddress+256, 2056);
        do Memory.poke(memAddress+288, 2056);
        do Memory.poke(memAddress+320, 4100);
        do Memory.poke(memAddress+352, 4100);
        do Memory.poke(memAddress+384, 8194);
        do Memory.poke(memAddress+416, 8194);
        do Memory.poke(memAddress+448, 16382);
        do Memory.poke(memAddress+480, 0);
        return;
    }

    method void drawClear(int location) {
        var int memAddress;
        let memAddress = 16384+location;
        do Memory.poke(memAddress+0, -16381);
        do Memory.poke(memAddress+32, -8185);
        do Memory.poke(memAddress+64, 28686);
        do Memory.poke(memAddress+96, 14364);
        do Memory.poke(memAddress+128, 7224);
        do Memory.poke(memAddress+160, 3696);
        do Memory.poke(memAddress+192, 2016);
        do Memory.poke(memAddress+224, 960);
        do Memory.poke(memAddress+256, 960);
        do Memory.poke(memAddress+288, 2016);
        do Memory.poke(memAddress+320, 3696);
        do Memory.poke(memAddress+352, 7224);
        do Memory.poke(memAddress+384, 14364);
        do Memory.poke(memAddress+416, 28686);
        do Memory.poke(memAddress+448, -8185);
        do Memory.poke(memAddress+480, -16381);
        return;
    }

    

// ############################################################################################

    /**
     * Selects and highlights a new drawing mode. This method should erase
     * the highlight from the previous mode and draw a new highlight around
     * the selected mode's icon.
     *
     * @param newMode The integer representing the new mode to select.
     */
    method void change_mode(int newMode) {
        if (newMode < NUM_BTNS + 1 & newMode > -1) { 
            do drawBorder(currentMode,false);
            let currentMode = newMode;
            do drawBorder(currentMode,true);
        }
        return;
    }

// ############################################################################################
// Optional
// ############################################################################################

    /**
     * Saves the portion of the drawing canvas that will be overwritten by instructions
     * into a temporary memory buffer.
     */
    method void showInstructions() {
        // let screenBuffer = Memory.alloc(ToolsControl.instructionsBufferSize);
        // ... copy screen content
        // ... display instructions
        return;
    }

    //* Restores the drawing canvas from the temporary buffer. */
    method void hideInstructions() {
        // ... copy buffer content to screen
        // do Memory.deAlloc(screenBuffer);
        return;
    }

    /**
     * Updates the size display on the toolbar.
     *
     * @param newSize The new integer value to display for the pen/shape size.
     */
    method void updateSize(int newSize) {
        return;
    }

// ############################################################################################
    



// ############################################################################################

    /**
     * Disposes this ToolsControl object and its resources.
     * This method must be called explicitly when the object is no longer needed.
     */
    method void dispose() {
        // 1) free any remaining buffers
        if (hasBuf) {
            do screenBuffer.dispose();
            let screenBuffer = null;
            let hasBuf = false;
        }
        // 2) free other arrays/strings you created with 'new' (if any)
        //    e.g., if you had: field Array modes; then: if (~(modes = null)) { do Array.dispose(modes); let modes = null; }

        // 3) finally, free this object (optional; only if you won’t use it again)
        do Memory.deAlloc(this);
        return;
    }
}
