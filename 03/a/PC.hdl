// File name: projects/03/a/PC.hdl

/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];

    PARTS:
    Register(in=next, load=toLoad, out=currVal);

    // Reset the PC to 0 if reset is true, otherwise keep the current value.
    Mux16(a=currVal, b=false, sel=reset, out=resetOut);
    // Increment the PC by 1 if inc is true, otherwise keep the current value.
    Inc16(in=currVal, out=incOut);

    // Select the appropriate output based on the control signals.
    Mux16(a=incOut, b=in, sel=load, out=incOrLoud);
    Mux16(a=incOrLoud, b=resetOut, sel=reset, out=next);

    // Determine if we should load the next value based on reset, load, or inc
    Or(a=reset, b=load, out=tempLoad);
    Or(a=tempLoad, b=inc, out=toLoad);

    // The output of the PC is the current value stored in the register.
    And16(a=currVal, b=true, out=out);
}
