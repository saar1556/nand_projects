// File name: projects/03/a/Bit.hdl

/**
 * 1-bit register:
 * If load[t] == 1 then out[t+1] = in[t]
 *                 else out does not change (out[t+1] = out[t])
 */

CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
    // Pull the current value of the bit that stored in DFF 
    // and store it in currval.
    Mux(a=currval, b=in, sel=load, out=nextOut);
    DFF(in=nextOut, out=currval);

    // The output of the DFF is controlled by the load signal used in the Mux.
    DFF(in=nextOut, out=out);
}
