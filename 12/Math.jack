/**
 * A library of commonly used mathematical functions.
 * Note: Jack compilers implement multiplication and division using OS method calls.
 */
class Math {

        static Array twoToThe;
        static int divHelper; // used by divide
        
        /** Initializes the library. */
        function void init() {
            let divHelper = 0;
            let twoToThe = Math.setTwoToThe();
            return;
        }

        /** Initializes the library. */
        function Array setTwoToThe() {
            var int i,len;
            var Array arr;

            let len=16;
            let arr = Array.new(len);
            let i=0;

            while (i < len) 
                {
                    if (i = 0) {
                        let arr[i] = 1;
                    }
                    else
                    {
                        let arr[i] = arr[i-1] + arr[i-1];
                    }
                    let i=i+1;
                }
            return arr;
        }

        /** Returns the absolute value of x. */
        function int abs(int x) {
            if (x > 0) {
                return x;
            } 
            return -x;
        }

        method Array decimalToBin(int x) {
            var int i;
            var Array bits;

            let bits = Array.new(16);
            let i = 15;

            while (i > -1) {
                if (x > twoToThe[i])
                    {
                        let bits[i] = true;
                        let x = x - twoToThe[i];
                    }
                else
                {
                    let bits[i] = false;
                }
                let i = i-1;
            }

            return bits;
        }

        method int binToDecimal(Array bits) {
            var int i,new_val,twoToTheI;
            
            let i=0;
            let new_val = 0;
            let twoToTheI = 1;

            while (i<16) {
                if (bits[i]) {
                    let new_val = twoToTheI + new_val;
                }
                let twoToTheI = twoToTheI*2;
                let i = i+1;
            }

            return new_val;
        }


        /** 
         * Returns the product of x and y. 
         * When a Jack compiler detects the multiplication operator '*' in the 
         * program's code, it handles it by invoking this method. In other words,
         * the Jack expressions x*y and multiply(x,y) return the same value.
         */
        function int multiply(int x, int y) {
            var int res, shiftedx, i;
            let res = 0;
            let shiftedx = x;
            let i = 0;

            while (i < 16) {
                if (~((y & twoToThe[i]) = 0)) {
                    let res = res + shiftedx;
                }
                let shiftedx = shiftedx+shiftedx;
                let i = i + 1;
            }

            return res;
        }

        /** 
         * Returns the integer part of x/y.
         * When a Jack compiler detects the multiplication operator '/' in the 
         * program's code, it handles it by invoking this method. In other words,
         * the Jack expressions x/y and divide(x,y) return the same value.
         */

        function int divide(int x, int y) {
            var int res, negative;
            
            // undifiend case
            if (y = 0) { return 0; }

            let negative = 0;
            if (x < 0) { let negative = 1; let x = Math.abs(x); }  
            if (y < 0) { let negative = 1 - negative ; let y = Math.abs(y); } 

            let divHelper = 0;
            let res = Math.divideHelper(x,y);

            if (negative) { return -res; }
            return res;
        }
        
        // recursiv helper function to divide
        function int divideHelper(int x, int y) {

            var int q, mult;
            
            if ((y > x) | (y < 0)) {  
                return 0;
            }

            let q = Math.divideHelper(x,y+y);

            // recursion case:
            if ((x - divHelper) < y) {
                return (q+q); // in the returned state, we will need to evaluate 2*qtag*ytag = 2*(2*q)(y/2) = 2*q*y
                              // meaning temp in the current iteration, is the same in the returend state
            }
            else {   
                // overflow protect
                if ((divHelper + y) < 0) {
                    return (0);
                }
                let divHelper = divHelper + y; // in the returned state, we will need to evaluate  2*qtag*ytag = 2*(2*q + 1)(y/2) = 2*q*y + y
                return (q+q+1);                // meaning temp in the current iteration, is less by 2ytag=y then the returend state
            }

        }


        function int leftShift(int x, int n) {
            var int i, result;
            let i = 0;
            let result = x;
            while (i < n) {
                let result = ^result;
                let i = i + 1;
            }
            return result;
        }
        

        /** Returns the integer part of the square root of x. */

        function int sqrt(int x) {
            var int y, ySquared, j, twoPowerJ, twoPower2J, candidate;
            
            let y = 0;
            let ySquared = 0;
            let j = 8;
            
            while (j > -1) {
                
                let twoPowerJ = twoToThe[j]; // 2**j
                let twoPower2J = Math.leftShift(twoPowerJ, j); // 2**(2j)
                let candidate = ySquared + Math.leftShift(y, j + 1) + twoPower2J; // (y+2**j)**2  = y**2 + y*(2**(j+1)) + 2**(2*j)
                
                if (((candidate - 1) < x) & (candidate > 0)) {
                    let y = y + twoPowerJ;
                    let ySquared = candidate;
                }
                let j = j - 1; 
            }
            return y;
        }

        /** Returns the greater number. */
        function int max(int a, int b) {
            if (a > b) {
                return a;
            } 
            return b;
        }

        /** Returns the smaller number. */
        function int min(int a, int b) {
            if (a < b) {
                return a;
            } 
            return b;
        }
}
