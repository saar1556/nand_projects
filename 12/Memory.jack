/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {

    static int ram, heap, freeList;

    /** Initializes the class. */
    function void init() {
        let ram = 0;
        let heap = 2048;

        let freeList=heap;
        let heap[0] = null;  // next free apace segment
        let heap[1] = 14335; // free space in current segment
        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        return ram[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        let ram[address] = value;
        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. Assume size > 0. */
    function Array alloc(int size) {

        var int size, blockLen;
        var Array block, prev, new_block, cur;

        let prev = null;
        let cur = freeList;

        while(~(cur = null)) {
            if (cur[1] > (size+2)) {

                if (cur[0] = null) {

                    if (prev = null) {  //    null -> cur -> null
                        // being freeList, so updating freeList accordingly
                        let blockLen = freeList[1] - (size + 2);
                        let freeList = freeList + (size + 2);
                        let freeList[1] = blockLen;
                    }
                    else        // ~null -> cur -> null
                    {
                        // shorting the last element (biggest) 
                        // and updating the biggest one fields
                        let prev[0] = cur + (size + 2);

                        let new_block = prev[0];
                        let new_block[0] = null;
                        let new_block[1] = cur[1] - (size + 2); 
                    }
                    
                    // updating size accordingly
                    let cur[1] = size + 2;
                }
                else // the size of the allocated area doesnt matter
                {
                    if (prev = null)  // null -> cur -> ~null
                    {
                        let freeList = freeList[0];
                    }
                    else  // // ~null -> cur -> ~null
                    {
                        let prev[0] = cur[0];
                    }
                }
                return cur;  
            }
            let prev = cur;
            let cur = cur[0];
        }
        return -1;
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        let o[0] = freeList;
        let freeList = o;
        return;
    }    

    /** Returns the maximal element contained in the given Array/object. 
     *  Assume inputs are initialized and contain at least one element. */
    function int max(Array o) {
        var int max,len,i;

        let len = o[-1];
        let i = 0;
        let max = o[0];

        while (i < len) {
            if (o[i] > max) {
                let max = o[i];
            }
            let i = i + 1;
        }
        return max;
    }
}
