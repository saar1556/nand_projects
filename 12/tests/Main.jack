// File: ScreenTest.jack
class Main {
    static int x, y;

    function void main() {

        // מחיקה של המסך
        do Screen.clearScreen();
        do Sys.wait(50);

        // הגדרת צבע שחור וצייר פיקסל בודד
        do Screen.setColor(true);
        let x = 10;
        let y = 5;
        do Screen.drawPixel(x, y);
        do Sys.wait(50);

        // שינוי צבע ללבן וצייר פיקסל נוסף
        do Screen.setColor(false);
        let x = 12;
        let y = 5;
        do Screen.drawPixel(x, y);
        do Sys.wait(50);

        // ציור קווים אופקיים, אנכיים ושיפועים
        do Screen.setColor(true);
        do Screen.drawLine(20, 10, 40, 10); // אופקי
        do Sys.wait(50);

        do Screen.drawLine(50, 5, 50, 20); // אנכי
        do Sys.wait(50);

        do Screen.drawLine(60, 5, 70, 15); // שיפוע
        do Sys.wait(50);

        // ציור מלבן מלא
        do Screen.setColor(true);
        do Screen.drawRectangle(5, 20, 15, 25);
        do Sys.wait(50);

        // ציור עיגול מלא
        do Screen.drawCircle(80, 50, 10);
        do Sys.wait(50);

        return;
    }
}
