/**
 * A library of functions for displaying graphics on the screen.
 * The Hack physical screen consists of 256 rows (indexed 0..255, top to bottom)
 * of 512 pixels each (indexed 0..511, left to right). The top left pixel on 
 * the screen is indexed (0,0).
 */
class Screen {
        static boolean color;
        static Array twoToThe,sixteenMulipliers,baseAddresses, sixteenDivisier; 

        /** Initializes the Screen. */
        function void init() {
            var int i, len;

            let len=16;
            let twoToThe = Array.new(len);
            let i=0;

            while (i < len) 
                {
                    if (i = 0) {
                        let twoToThe[i] = 1;
                    }
                    else
                    {
                        let twoToThe[i] = twoToThe[i-1] + twoToThe[i-1];
                    }
                    let i=i+1;
                }
            do Screen.clearScreen();
            do Screen.initArrays();
            let color = true;
            return;
        }

        function void initArrays() {
            var int i, culmative, value, counter;

            let twoToThe = Array.new(16);
            let sixteenMulipliers = Array.new(32);
            let baseAddresses = Array.new(256);

            let i = 0;
            while (i < 16) {
                if (i = 0) {let twoToThe[i] = 1;}
                else {let twoToThe[i] = twoToThe[i-1] + twoToThe[i-1];}
                let i = i+1;
            }

            let culmative = 0;
            let i = 0;
            while (i<32) {
                let sixteenMulipliers[i] = culmative;
                let culmative = culmative + 16;
                let i = i+1;
            }

            let culmative = 16384;
            let i = 0;
            while (i < 256) {
                let baseAddresses[i] = culmative;
                let culmative = culmative + 32;
                let i = i+1;
            }

            let sixteenDivisier = Array.new(516);
            let counter = 0;
            let i = 0;
            let value = 0;
            while (i < 516) {
                let sixteenDivisier[i] = value;
                let i = i + 1;

                let counter = counter + 1;
                if (counter = 16) {
                    let counter = 0;
                    let value = value + 1;
                }
            }

            return;
        }


        /** Erases the entire screen. */
        function void clearScreen() {
            var int i;
            let i = 0;
            while (i < 8192) { // 256 rows * 512 bits / 16 = 8192 words
                do Memory.poke(16384 + i, 0); // clear all words
                let i = i + 1;
            }
            return;
        }

        /** Sets the current color, to be used for all subsequent drawXXX commands.
         *    Black is represented by true, white by false. */
        function void setColor(boolean b) {
            let color = b;
            return;
        }


        function int shiftRight(int value, int shiftAmount) {
            var int i;
            let i = 0;
            while (i < shiftAmount) {
                let value = #value;
                let i = i + 1;
            }
            return value;
        }

        /** Draws the (x,y) pixel, using the current color. */
        function void drawPixel(int x, int y) {
            var int x_over,r,addr,value,post_value;
            
            let x_over = sixteenDivisier[x];
            let r = x - sixteenMulipliers[x_over];
            let addr = baseAddresses[y] + x_over;

            let value = Memory.peek(addr);
            if (color) {
                let post_value = value | twoToThe[r];
            }
            else  {
                let post_value = value & (~twoToThe[r]);
            }
            do Memory.poke(addr,post_value); 
            
            return;
        }

        /** Draws a line from pixel (x1,y1) to pixel (x2,y2), using the current color. */
        function void drawLine(int x1, int y1, int x2, int y2) {
            var int x, y, a, b, diff, dx, dy, wordStart, wordEnd, i, address;
            var int addA,addB, baseAddr;
            
            let x = x1;
            let y = y1;
            let a = 0;
            let diff = 0;
            let dx = Math.abs(x1 - x2);
            let dy = Math.abs(y1 - y2);

            if (x2 > x1) {let addA = 1;}
            else {let addA = -1;}

            if (y2 > y1) { let addB = 1;}
            else {let addB = -1;}

            // Case: horizontal line
            if (dy = 0) {
                // Compute word indices
                let wordStart = sixteenDivisier[x1]; // x1 / 16
                let wordEnd = sixteenDivisier[x2];   // x2 / 16

                // Same word — draw pixel by pixel
                if (wordStart = wordEnd) {
                    let i = x1;
                    while (i < (x2 + 1)) {
                        do Screen.drawPixel(i, y1);
                        let i = i + 1;
                    }
                return;
                }
                // First partial word
                let i = x1;
                while (i < sixteenDivisier[wordStart + 1]) {
                    do Screen.drawPixel(i, y1);
                    let i = i + 1;
                }
                // Full words — draw entire 16-bit values
                let i = wordStart + 1;
                while (i < wordEnd) {
                    let baseAddr = baseAddresses[y];
                    let address = (baseAddr + i);
                    if (color) {
                        do Memory.poke(address, -1); // 0xFFFF
                    } else {
                        do Memory.poke(address, 0); // 0x0000
                    }
                    let i = i + 1;
                }
                // Last partial word
                let i = sixteenDivisier[wordEnd];
                while (i < (x2 + 1)) {
                    do Screen.drawPixel(i, y1);
                    let i = i + 1;
                }
                return;
            }

            // Case: vertical line
            if (dx = 0) {
                let i = y1;
                while (i < (y2 + 1)) {
                    do Screen.drawPixel(x1, i);
                    let i = i + 1;
                }
                return;
            }

            // General case: diagonal or sloped line
            /**while ((a < (dx + 1)) & (b < (dy + 1))) {
                do Screen.drawPixel((x + a), (y + b));
                if (diff < 0) {
                    let a = a + 1;
                    let diff = diff + dy;
                }
                else {
                    let b = b + 1;
                    let diff = diff - dx;
                }
            }*/
            //return; 

                    
            while ((Math.abs(a) < (dx + 1)) & (Math.abs(b) < (dy + 1))) {
                do Screen.drawPixel((x + a), (y + b));
                if (diff < 0) {
                    let a = a + 1;
                    let diff = diff + dy;
                }
                else {
                    let b = b + 1;
                    let diff = diff - dx;
                }
            }

            return;
        }

        /** Draws a filled rectangle whose top left corner is (x1, y1)
         * and bottom right corner is (x2,y2), using the current color. */
        function void drawRectangle(int x1, int y1, int x2, int y2) {
            var int i, add;
            if (y1 < y2){
                let add = 1;
            }
            else {
                let add = -1;
            }
            let i = y1;
            while (~(i = (y2 + add))) {
                do Screen.drawLine(x1, i, x2, i);
                let i = i + add;
            }
            return;
        }

        /** Draws a filled circle of radius r<=181 around (x,y), using the current color. */
        function void drawCircle(int x, int y, int r) {

            var int dy, halfWidth;
            if (r > 181) {
                let r = 181;
            }
            let dy = -r;
            while (dy < (r + 1)) {
                let halfWidth = Math.sqrt((r*r) - (dy*dy));
                do Screen.drawLine((x-halfWidth), (y+dy), (x+halfWidth), (y+dy));
                let dy = (dy + 1);
            }
            return;
        }
        
}
