/**
 * A library of functions for displaying graphics on the screen.
 * The Hack physical screen consists of 256 rows (indexed 0..255, top to bottom)
 * of 512 pixels each (indexed 0..511, left to right). The top left pixel on 
 * the screen is indexed (0,0).
 */
class Screen {

        // Static fields:
        static boolean color;
        static Array twoToThe,sixteenMulipliers,baseAddresses, sixteenDivisier; 

        /** Initializes the Screen. */
        function void init() {
            do Screen.clearScreen();
            do Screen.initArrays();
            let color = true;
            return;
        }

        
        // Initializes lookup arrays
        function void initArrays() {
            var int i, culmative, value, counter;

            // NOTE: Arrays are used for fast computation of pixel positions
            let twoToThe = Array.new(16);          // Powers of 2 for pixel bit masks
            let sixteenMulipliers = Array.new(32); // Precomputed multiples of 16
            let baseAddresses = Array.new(256);    // Base RAM addresses for each row
            let sixteenDivisier = Array.new(516);  // Precomputed divisions of 16

            // Fill twoToThe array
            let i = 0;
            while (i < 16) 
                {
                    if (i = 0) {
                        let twoToThe[i] = 1;
                    }
                    else {
                        let twoToThe[i] = twoToThe[i-1] + twoToThe[i-1];
                    }
                    let i=i+1;
                }

            // Fill sixteenMulipliers array: 0,16,32,...,496
            let culmative = 0;
            let i = 0;
            while (i<32) {
                let sixteenMulipliers[i] = culmative;
                let culmative = culmative + 16;
                let i = i+1;
            }

            // Fill baseAddresses array: 16384, 16384+32, ..., for 256 rows
            let culmative = 16384;
            let i = 0;
            while (i < 256) {
                let baseAddresses[i] = culmative;
                let culmative = culmative + 32;
                let i = i+1;
            }

            // Fill sixteenDivisier array: repeated sequence for x/16 lookup
            let counter = 0;
            let i = 0;
            let value = 0;
            while (i < 516) {
                let sixteenDivisier[i] = value;
                let i = i + 1;

                let counter = counter + 1;
                if (counter = 16) {
                    let counter = 0;
                    let value = value + 1;
                }
            }

            return;
        }


        /** Erases the entire screen. */
        function void clearScreen() {
            var int i;
            let i = 0;
            while (i < 8192) { // 256 rows * 512 bits / 16 = 8192 words
                do Memory.poke(16384 + i, 0); // clear all words
                let i = i + 1;
            }
            return;
        }

        /** Sets the current color, to be used for all subsequent drawXXX commands.
         *    Black is represented by true, white by false. */
        function void setColor(boolean b) {
            let color = b;
            return;
        }

        function boolean getColor() {
            return color;
        }


        /** Draws the (x,y) pixel, using the current color. */
        function void drawPixel(int x, int y) {
            var int x_over,r,addr,value,post_value;
            
            // Compute 16-bit word index and pixel offset
            let x_over = sixteenDivisier[x];
            let r = x - sixteenMulipliers[x_over];
            let addr = baseAddresses[y] + x_over;

            let value = Memory.peek(addr);
            if (color) {
                let post_value = value | twoToThe[r];
            }
            else  {
                let post_value = value & (~twoToThe[r]);
            }
            do Memory.poke(addr,post_value); 
            
            return;
        }

        /** Draws a line from (x1,y1) to (x2,y2) using current color. */
        function void drawLine(int x1, int y1, int x2, int y2) {
            var int dx, dy, sx, sy, err, e2;
            var int wStart, wEnd, i, addr, t;

            // -------------------------
            // Horizontal line (y1 == y2)
            // -------------------------
            if (y1 = y2) {
                // normalize order so x1 <= x2
                if (x2 < x1) { let t = x1; let x1 = x2; let x2 = t; }

                let wStart = sixteenDivisier[x1];  // x1 / 16 (lookup)
                let wEnd   = sixteenDivisier[x2];  // x2 / 16 (lookup)

                if (wStart = wEnd) {
                    // same 16-pixel word draw pixels
                    let i = x1;
                    while (i < (x2 + 1)) {
                        do Screen.drawPixel(i, y1);
                        let i = i + 1;
                    }
                    return;
                }

                // left partial word
                let i = x1;
                while (i < sixteenMulipliers[wStart + 1]) {
                    do Screen.drawPixel(i, y1);
                    let i = i + 1;
                }

                // full words
                let i = wStart + 1;
                while (i < wEnd) {
                    let addr = baseAddresses[y1] + i;
                    if (color) { do Memory.poke(addr, -1); }  // 0xFFFF
                    else       { do Memory.poke(addr, 0);   } // 0x0000
                    let i = i + 1;
                }

                // right partial word
                let i = sixteenMulipliers[wEnd];
                while (i < (x2 + 1)) {
                    do Screen.drawPixel(i, y1);
                    let i = i + 1;
                }
                return;
            }

            // -------------------------
            // Vertical line (x1 == x2)
            // -------------------------
            if (x1 = x2) {
                // normalize order so y1 <= y2
                if (y2 < y1) { let t = y1; let y1 = y2; let y2 = t; }
                let i = y1;
                while (i < (y2 + 1)) {
                    do Screen.drawPixel(x1, i);
                    let i = i + 1;
                }
                return;
            }

            // -------------------------
            // General case: integer Bresenham
            // -------------------------
            let dx = Math.abs(x2 - x1);
            let dy = Math.abs(y2 - y1);

            if (x1 < x2) { let sx = 1; } else { let sx = -1; }
            if (y1 < y2) { let sy = 1; } else { let sy = -1; }

            let err = dx - dy;

            while (true) {
                do Screen.drawPixel(x1, y1);

                if ((x1 = x2) & (y1 = y2)) { return; }

                let e2 = err + err;

                if (e2 > (0 - dy)) {
                    let err = err - dy;
                    let x1 = x1 + sx;
                }
                if (e2 < dx) {
                    let err = err + dx;
                    let y1 = y1 + sy;
                }
            }
            return;
        }


        /** Draws a filled rectangle whose top left corner is (x1, y1)
         * and bottom right corner is (x2,y2), using the current color. */
        function void drawRectangle(int x1, int y1, int x2, int y2) {
            var int i, add;
            if (y1 < y2){
                let add = 1;
            }
            else {
                let add = -1;
            }
            let i = y1;
            while (~(i = (y2 + add))) {
                do Screen.drawLine(x1, i, x2, i);
                let i = i + add;
            }
            return;
        }

        /** Draws a filled circle of radius r<=181 around (x,y), using the current color. */
        function void drawCircle(int x, int y, int r) {

            var int dy, halfWidth;
            if (r > 181) {
                let r = 181;
            }
            let dy = -r;
            while (dy < (r + 1)) {
                let halfWidth = Math.sqrt((r*r) - (dy*dy));
                do Screen.drawLine((x-halfWidth), (y+dy), (x+halfWidth), (y+dy));
                let dy = (dy + 1);
            }
            return;
        }
        
}
