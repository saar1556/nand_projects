/**
 * A library of functions for displaying graphics on the screen.
 * The Hack physical screen consists of 256 rows (indexed 0..255, top to bottom)
 * of 512 pixels each (indexed 0..511, left to right). The top left pixel on 
 * the screen is indexed (0,0).
 */
class Screen {

    static boolean color;
    static Array twoToThe; 
    static Array rowBase;   // 256 entries: base RAM addr for each y row
    static Array maskSet;   // 16 entries:  1<<b
    static Array maskClr;   // 16 entries: ~maskSet[b]

    function void init() {
        var int i, base;

        // --- masks ---
        let maskSet = Array.new(16);
        let maskClr = Array.new(16);
        let maskSet[0] = 1;
        let i = 1;
        while (i < 16) {
            let maskSet[i] = maskSet[i-1] + maskSet[i-1]; // double = <<1
            let i = i + 1;
        }
        let i = 0;
        while (i < 16) {
            let maskClr[i] = ~maskSet[i];  // 16-bit NOT in Hack
            let i = i + 1;
        }

        // --- row bases: 16384 + y*32 (computed with plain adds) ---
        let rowBase = Array.new(256);
        let base = 16384;
        let i = 0;
        while (i < 256) {
            let rowBase[i] = base;
            let base = base + 32;  // next row is +32 words
            let i = i + 1;
        }
        do Screen.clearScreen();
        let color = true;
        return;
    }


    /** Draws pixel (x,y) with the current color (0/1 in the 'color' var). */
    function void drawPixel(int x, int y) {
        var int addr, val, bit, m;

        // addr = rowBase[y] + x/16   (only one divide per pixel)
        let addr = rowBase[y] + (x / 16);
        let val  = Memory.peek(addr);

        // bit inside the 16-pixel word
        let bit = x & 15;        // x % 16
        let m   = maskSet[bit];

        if (color) {
            // only poke if the bit is currently 0
            if ((val & m) = 0) {
                do Memory.poke(addr, val | m);
            }
        } else {
            // only poke if the bit is currently 1
            if ((val & m) = m) {
                do Memory.poke(addr, val & maskClr[bit]);
            }
        }
        return;
    }

        /** Initializes the Screen. */
        /**function void init() {
            var int i,len;

            let len=16;
            let twoToThe = Array.new(len);
            let i=0;

            while (i < len) 
                {
                    if (i = 0) {
                        let twoToThe[i] = 1;
                    }
                    else
                    {
                        let twoToThe[i] = twoToThe[i-1] + twoToThe[i-1];
                    }
                    let i=i+1;
                }
            do Screen.clearScreen();
            let color = true;
            return;
        }*/

        /** Erases the entire screen. */
        function void clearScreen() {
            var int i;
            let i = 0;
            while (i < 8192) { // 256 rows * 512 bits / 16 = 8192 words
                do Memory.poke(16384 + i, 0); // clear all words
                let i = i + 1;
            }
            return;
        }

        /** Sets the current color, to be used for all subsequent drawXXX commands.
         *    Black is represented by true, white by false. */
        function void setColor(boolean b) {
            let color = b;
            return;
        }

        function int shiftLeft(int value, int shiftAmount) {
            var int i;
            let i = 0;
            while (i < shiftAmount) {
                let value = ^value;
                let i = i + 1;
            }
            return value;
        }

        function int shiftRight(int value, int shiftAmount) {
            var int i;
            let i = 0;
            while (i < shiftAmount) {
                let value = #value;
                let i = i + 1;
            }
            return value;
        }

        /** Draws the (x,y) pixel, using the current color. */
        /**function void drawPixel(int x, int y) {
            var int y32, xDev16, address, addressVal, xMod16;
            let xDev16 = Screen.shiftRight(x, 4);
            let y32 = Screen.shiftLeft(y, 5);
            let address = (xDev16 + y32 + 16384);
            let addressVal = Memory.peek(address);
            let xMod16 = x & 15;
            // set the specific pixel to 1
            if (color) {
                let addressVal = (addressVal | Screen.shiftLeft(1, xMod16));
            }
            // set the specific pixel to 0
            else {
                let addressVal = (addressVal & (~(Screen.shiftLeft(1, xMod16))));
            }
            do Memory.poke(address, addressVal);
            return;
        }*/

        /** Draws the (x,y) pixel, using the current color. */
        /**function void drawPixel(int x, int y) {
            // For this function, you will need to calculate the value x%16.
            // It should be calculated quickly without using multiplication or
            // division, using exactly one basic math/logical operation.
            // In addition, calculating 16384 + y * 32 + x/16 should not use
            // division or multiplication.
            // Pseudocode:
            // 1. Compute the RAM address where the (x,y) pixel is
            //    represented: 16384 + (32*y) + (x/16).
            // 2. Use Memory.peek to get the 16-bit value of this address
            // 3. Use some bitwise operation to set (only) the bit that corresponds
            //    to the pixel to the current color.
            // 4. Use Memory.poke to write the modified 16-bit value to the RAM
            // address.
            var int address,r, value;
            var Array bits;

            let address = 32*y + (x/16);
            let value = Memory.peek((16384+address));
            
            // setting new value
            let bits = Screen.decimalToBin(value);
            let r = x - ((x/16)*16);
            let bits[r] = color;
            let value = Screen.binToDecimal(bits);
            do Memory.deAlloc(bits);

            //let value[r] = currentColor;
            do Memory.poke(address,value);
            return;

        }*/

        function Array decimalToBin(int x) {
            var int i;
            var Array bits;

            let bits = Array.new(16);
            let i = 15;

            while (i > -1) {
                if (x > twoToThe[i])
                    {
                        let bits[i] = true;
                        let x = x - twoToThe[i];
                    }
                else
                {
                    let bits[i] = false;
                }
                let i = i-1;
            }

            return bits;
        }

        function int binToDecimal(Array bits) {
            var int i,new_val;
            
            let i=0;
            let new_val = 0;

            while (i<16) {
                if (bits[i]) {
                    let new_val = twoToThe[i] + new_val;
                }
                //let twoToThe[i] = twoToThe*2;
                let i = i+1;
            }

            return new_val;
        }

        /** Draws a line from pixel (x1,y1) to pixel (x2,y2), using the current color. */
        function void drawLine(int x1, int y1, int x2, int y2) {

            var int x, y, a, b, diff, dx, dy, wordStart, wordEnd, i, address;
            let x = x1;
            let y = y1;
            let a = 0;
            let diff = 0;
            let dx = Math.abs(x1 - x2);
            let dy = Math.abs(y1 - y2);
            
            // Case: horizontal line
            if (dy = 0) {
                 // Compute word indices
                let wordStart = Screen.shiftRight(x1, 4); // x1 / 16
                let wordEnd = Screen.shiftRight(x2, 4);   // x2 / 16

                // Same word — draw pixel by pixel
                if (wordStart = wordEnd) {
                    let i = x1;
                    while (i < (x2 + 1)) {
                        do Screen.drawPixel(i, y1);
                        let i = i + 1;
                    }
                return;
                }
                // First partial word
                let i = x1;
                while (i < Screen.shiftLeft(wordStart + 1, 4)) {
                    do Screen.drawPixel(i, y1);
                    let i = i + 1;
                }
                // Full words — draw entire 16-bit values
                let i = wordStart + 1;
                while (i < wordEnd) {
                    let address = (16384 + Screen.shiftLeft(y1, 5) + i);
                    if (color) {
                        do Memory.poke(address, -1); // 0xFFFF
                    } else {
                        do Memory.poke(address, 0); // 0x0000
                    }
                    let i = i + 1;
                }
                // Last partial word
                let i = Screen.shiftLeft(wordEnd, 4);
                while (i < (x2 + 1)) {
                    do Screen.drawPixel(i, y1);
                    let i = i + 1;
                }
                return;
            }

            // Case: vertical line
            if (dx = 0) {
                let i = y1;
                while (i < (y2 + 1)) {
                    do Screen.drawPixel(x1, i);
                    let i = i + 1;
                }
                return;
            }

            // General case: diagonal or sloped line
            while ((a < (dx + 1)) & (b < (dy + 1))) {
                do Screen.drawPixel((x + a), (y + b));
                if (diff < 0) {
                    let a = a + 1;
                    let diff = diff + dy;
                }
                else {
                    let b = b + 1;
                    let diff = diff - dx;
                }
            }
            return;
        }

        /** Draws a filled rectangle whose top left corner is (x1, y1)
         * and bottom right corner is (x2,y2), using the current color. */
        function void drawRectangle(int x1, int y1, int x2, int y2) {
            var int i, add;
            if (y1 < y2){
                let add = 1;
            }
            else {
                let add = -1;
            }
            let i = y1;
            while (~(i = (y2 + add))) {
                do Screen.drawLine(x1, i, x2, i);
                let i = i + add;
            }
            return;
        }

        /** Draws a filled circle of radius r<=181 around (x,y), using the current color. */
        function void drawCircle(int x, int y, int r) {

            var int dy, halfWidth;
            if (r > 181) {
                let r = 181;
            }
            let dy = -r;
            while (dy < (r + 1)) {
                let halfWidth = Math.sqrt((r*r) - (dy*dy));
                //do Output.printInt(x-halfWidth);
                //do Output.printString(",  ");
                //do Output.printInt(x+halfWidth);
                //do Output.println();
                do Screen.drawLine((x-halfWidth), (y+dy), (x+halfWidth), (y+dy));
                //do Sys.wait(100);
                let dy = (dy + 1);
            }
            return;
        }
        
}
