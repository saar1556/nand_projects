/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O. 
 * The chip facilitates read and write operations, as follows:
 *     Read:  out(t) = Memory[address(t)](t)
 *     Write: if load(t-1) then Memory[address(t-1)](t) = in(t-1)
 * In words: the chip always outputs the value stored at the memory 
 * location specified by address. If load==1, the in value is loaded 
 * into the memory location specified by address. This value becomes 
 * available through the out output from the next time step onward.
 * Address space rules:
 * Only the upper 16K+8K+1 words of the Memory chip are used. 
 * Access to address>0x6000 is invalid. Access to any address in 
 * the range 0x4000-0x5FFF results in accessing the screen memory 
 * map. Access to address 0x6000 results in accessing the keyboard 
 * memory map. The behavior in these addresses is described in the 
 * Screen and Keyboard chip specifications given in the book.
 */

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // RAM: 000000000000000 to 01111111111111
    // Screen: 100000000000000 to 10111111111111
    // Keyboard: 110000000000000

    // check if its RAM valid address and load signal
    Not(in=address[14], out=isRAMRange);
    And (a=isRAMRange, b=load, out=loadRAM);

    // check if its Screen valid address and load signal
    Not (in=address[13], out=notA13);
    And (a=address[14], b=notA13, out=isScreenRange);
    And (a=isScreenRange, b=load, out=loadScreen);

    // check if its KBD valid address 
    // Or8Way(in=address[0..7], out=low1);
    // Or8Way(in[0..4]=address[8..12], in[5..7]=false, out=low2);
    // Or(a=low1, b=low2, out=anyLowBit);
    // Not(in=anyLowBit, out=lowIsZero);
    // And (a=address[14], b=address[13], out=twoHighBits);
    // And (a=twoHighBits, b=lowIsZero, out=validKbdAddress);

    // load and get outputs from RAM, Screen, and Keyboard
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);
    Screen (in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard (out=keyboardOut);

    // check if the address is valid for RAM, Screen, or Keyboard
    //Or (a=validKbdAddress, b=isRAMRange, out=valid1);
    //Or (a=valid1, b=isScreenRange, out=finalValid);

    // Mux to select the output based on the address validity
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=keyboardOut, sel[0]=address[13], sel[1]=address[14], out=out);
}