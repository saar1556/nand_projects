// File name: projects/01/Or8Way.hdl

/**
 * 8-way Or: 
 * out = (in[0] or in[1] or ... or in[7])
 */

CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
        Or (in=in[0], b=in[1], out=out1);
        Or (in=in[2], b=in[3], out=out2);
        Or (in=in[4], b=in[5], out=out3);
        Or (in=in[6], b=in[7], out=out4);
        Or (in=out1, b=out2, out=out5);
        Or (in=out3, b=out4, out=out6);
        Or (in=) 
}