// File name: projects/01/Xor.hdl

/**
 * Exclusive-or gate:
 * out = not (a == b)
 */

CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Nand (a=a, b=a, out=nota);
    Nand (a=b, b=b, out=notb);
    And (a=a ,b=notb, out=anb);
    And (a=nota, b=b, out=nab);
    Or (a=anb, b=nab, out=out);
}