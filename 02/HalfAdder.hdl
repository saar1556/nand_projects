// File name: projects/02/HalfAdder.hdl

/**
 * Computes the sum of two bits.
 */

CHIP HalfAdder {
    IN a, b;    // 1-bit inputs
    OUT sum,    // Right bit of a + b 
        carry;  // Left bit of a + b

    PARTS:
    Not (in=a, out=notA);
    Not (in=b, out=notB);
    And (a=a, b=b, out=carry); 
    And (a=a, b=notB, out=and1);
    And (a=notA, b=b, out=and2);
    Or (a=and1, b=and2, out=sum);  
}
